# Arguments for the liscere-observe service. Edit, then: sudo systemctl restart liscere-observe
# The capture interface (the port that receives the mirror).
IFACE=eth0
# Probe window: which protocols are on the wire (seconds).
PROBE=15
# Observe window: discover the state signal and calibrate (seconds; cover at least 1.5 process cycles).
OBSERVE=300
# Learn window: build the operational grammar (seconds); evaluation is continuous after it.
LEARN=900
# Anything else, e.g. --only opcua --reset-after 50000
EXTRA_ARGS=
